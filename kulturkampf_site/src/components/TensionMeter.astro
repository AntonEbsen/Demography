---
const quotes = [
    {
        side: "bismarck",
        text: "We are not going to Canossa—neither in the body nor in the spirit!",
        source: "Speech to the Reichstag, 1872",
        intensity: 90
    },
    {
        side: "vatican",
        text: "The state has no right to interfere in the internal affairs of the Church, which is a perfect society in itself.",
        source: "Pope Pius IX, Quod Nunquam, 1875",
        intensity: 85
    },
    {
        side: "bismarck",
        text: "Every priest must be a German and a citizen of the state first, and a servant of Rome second.",
        source: "Draft of the May Laws, 1873",
        intensity: 75
    },
    {
        side: "vatican",
        text: "These laws are null and void, for they contradict the divine constitution of the Church.",
        source: "Encyclical on the Prussian Laws, 1875",
        intensity: 95
    }
];
---

<div class="tension-meter">
    <h3>The Tension Meter</h3>
    <p>Toggle between the "Iron" and the "Altar" to see the escalating rhetoric of the 1870s.</p>

    <div class="meter-controls">
        <button class="meter-btn active" data-side="bismarck">The Iron (State)</button>
        <button class="meter-btn" data-side="vatican">The Altar (Church)</button>
    </div>

    <div class="meter-display">
        <div class="needle-track">
            <div id="tension-needle" class="needle"></div>
        </div>
        <div class="quote-box" id="quote-box">
            <p id="quote-text">"We are not going to Canossa—neither in the body nor in the spirit!"</p>
            <cite id="quote-source">— Speech to the Reichstag, 1872</cite>
        </div>
    </div>
</div>

<script is:inline define:vars={{ quotes }}>
    const buttons = document.querySelectorAll('.meter-btn');
    const needle = document.getElementById('tension-needle');
    const text = document.getElementById('quote-text');
    const source = document.getElementById('quote-source');

    let currentIndex = 0;

    const updateMeter = (side) => {
        const sideQuotes = quotes.filter(q => q.side === side);
        const q = sideQuotes[0]; // Simplified: just show first for now or cycle

        text.innerText = `"${q.text}"`;
        source.innerText = `— ${q.source}`;
        needle.style.transform = `rotate(${(q.intensity / 100) * 180 - 90}deg)`;
        
        const color = side === 'bismarck' ? 'var(--state)' : 'var(--church)';
        needle.style.backgroundColor = color;
    };

    buttons.forEach(btn => {
        btn.onclick = () => {
            buttons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            updateMeter(btn.dataset.side);
        };
    });

    updateMeter('bismarck');
</script>

<style>
    .tension-meter {
        background: #000;
        border: 1px solid var(--border);
        padding: 3rem;
        border-radius: 8px;
        margin: 4rem 0;
        text-align: center;
    }

    .meter-controls {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin: 2rem 0;
    }

    .meter-btn {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-muted);
        padding: 0.8rem 1.5rem;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
    }

    .meter-btn.active {
        border-color: var(--accent);
        color: var(--accent);
        background: rgba(212, 175, 55, 0.05);
    }

    .meter-display {
        margin-top: 3rem;
    }

    .needle-track {
        width: 200px;
        height: 100px;
        border: 2px solid var(--border);
        border-bottom: none;
        border-top-left-radius: 100px;
        border-top-right-radius: 100px;
        margin: 0 auto 2rem;
        position: relative;
        overflow: hidden;
    }

    .needle {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 4px;
        height: 80px;
        background: var(--accent);
        transform-origin: bottom center;
        transition: transform 1s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s;
        box-shadow: 0 0 15px rgba(0,0,0,0.5);
    }

    .quote-box {
        min-height: 150px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    #quote-text {
        font-family: var(--serif);
        font-size: 1.6rem;
        font-style: italic;
        margin-bottom: 1rem;
    }

    #quote-source {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1rem;
        opacity: 0.6;
    }
</style>
