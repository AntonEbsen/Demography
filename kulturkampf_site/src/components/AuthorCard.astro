<div class="author-card">
    <div class="author-content">
        <div class="author-info">
            <h4>Anton Ebsen</h4>
            <p class="author-title">Quantitative Economic Historian</p>
            <p class="author-bio">Aspiring PhD candidate specializing in the demographic and institutional history of 19th-century Europe. Combining archival rigor with modern econometric pipelines.</p>
            <div class="author-links">
                <a href="https://antonebsen.dk/" target="_blank">Personal Website</a>
                <a href="https://github.com/AntonEbsen" target="_blank">GitHub</a>
                <a href="mailto:contact@antonebsen.dk">Email</a>
            </div>
        </div>
    </div>
</div>

<style>
    .author-card {
        max-width: 800px;
        margin: 4rem auto 0;
        padding: 3rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        text-align: left;
    }

    .author-info h4 {
        font-size: 1.8rem;
        margin-bottom: 0.2rem;
        color: var(--accent);
    }

    .author-title {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1rem;
        opacity: 0.6;
        margin-bottom: 1.5rem;
    }

    .author-bio {
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 2rem;
        opacity: 0.9;
    }

    .author-links {
        display: flex;
        gap: 2rem;
    }

    .author-links a {
        color: var(--accent);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.05rem;
    }

    .author-links a:hover {
        text-decoration: underline;
    }
</style>
