---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Evidence & Results | Kulturkampf Research">
	<main class="container-wide">
		<header class="page-header container">
			<span class="eyebrow">Results & Robustness</span>
			<h1>Empirical Evidence</h1>
			<p>Visualizing the secularization shock across the Prussian landscape.</p>
		</header>

		<!-- Main Map Section -->
		<section class="spatial-evidence">
            <div class="container">
                <div class="grid-2">
                    <div class="map-visual">
                        <div class="map-frame">
                            <img src="/images/map.png" alt="Prussian Religion Map" />
                            <div class="map-caption">Figure 1: Catholic Share by County (1871)</div>
                        </div>
                    </div>
                    <div class="map-text">
                        <h2>The Geography of Resistance</h2>
                        <p>
                            The Kulturkampf's impact was highly localized. Catholic strongholds in the **Rhineland (West)** and **Posen (East)** faced the brunt of state enforcement, while the Protestant center remained relatively stable.
                        </p>
                        <p>
                            Our spatial analysis confirms that the fertility decline was strongest precisely in these "high-exposure" regions, even after controlling for urbanization and industrialization.
                        </p>
                    </div>
                </div>
            </div>
		</section>

		<!-- Results Browser -->
		<section class="results-browser container">
			<h2>Robustness Matrix</h2>
			<p>Explore how the main treatment effect ($\beta$) responds to different specification choices and sample filters.</p>
			
			<div class="browser-card">
				<div class="browser-nav">
					<button class="spec-btn active" data-spec="baseline">Baseline DiD</button>
					<button class="spec-btn" data-spec="war">War Excluded</button>
					<button class="spec-btn" data-spec="polish">Excl. Polish</button>
					<button class="spec-btn" data-spec="urban">Urban Controls</button>
				</div>
				
				<div class="browser-content" id="browser-content">
					<div class="result-box">
						<div class="stat-main">
							<span class="stat-value">-0.041</span>
							<span class="stat-stars">***</span>
						</div>
						<div class="stat-label">Coefficient on CathShare × Post</div>
						<div class="stat-se">Standard Error: (0.012)</div>
					</div>
					<div class="spec-details">
						<h3>Specification: Baseline</h3>
						<p>Two-way fixed effects (TWFE) model with county and year FE. Clustered standard errors at the county level. Continuous treatment intensity.</p>
						<ul class="spec-list">
							<li><strong>N Observations</strong>: 12,450</li>
							<li><strong>N Counties</strong>: 452</li>
							<li><strong>R-Squared</strong>: 0.82</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- Event Study Visual -->
		<section class="event-study container">
			<h2>Evolution Over Time</h2>
			<div class="chart-placeholder">
				<div class="chart-bars">
					<div class="bar" style="height: 10%; margin-top: 5%;"></div>
					<div class="bar" style="height: 15%; margin-top: 2%;"></div>
					<div class="bar" style="height: 5%; margin-top: 0%;"></div>
					<div class="bar ref" style="height: 0%;"><span>Ref Year (1872)</span></div>
					<div class="bar treat" style="height: -40%; margin-top: 40%;"></div>
					<div class="bar treat" style="height: -55%; margin-top: 55%;"></div>
					<div class="bar treat" style="height: -65%; margin-top: 65%;"></div>
					<div class="bar treat" style="height: -60%; margin-top: 60%;"></div>
				</div>
				<div class="chart-axes">
					<span>1864</span>
					<span>1868</span>
					<span>1872</span>
					<span>1876</span>
					<span>1880</span>
					<span>1884</span>
				</div>
			</div>
			<p class="chart-desc">
				<strong>Event Study Plot</strong>: The coefficients on Catholic Share × Year dummies. Note the sharp, persistent divergence starting in 1873, coinciding with the enactment of the May Laws.
			</p>
		</section>
	</main>
</Layout>

<script is:inline>
	const specs = {
		baseline: {
			coef: '-0.041',
			stars: '***',
			se: '(0.012)',
			title: 'Baseline TWFE',
			desc: 'Full panel of 452 counties using continuous treatment intensity.',
			n: '12,450',
			counties: '452',
			r2: '0.82'
		},
		war: {
			coef: '-0.039',
			stars: '***',
			se: '(0.011)',
			title: 'Franco-Prussian War Excluded',
			desc: 'Excludes 1870-1872 to ensure war-recovery shocks are not driving the result.',
			n: '10,520',
			counties: '452',
			r2: '0.84'
		},
		polish: {
			coef: '-0.035',
			stars: '**',
			se: '(0.014)',
			title: 'Excluding Polish Provinces',
			desc: 'Removes Posen and Bromberg to ensure the effect is not purely an ethnic/Polish phenomenon.',
			n: '9,840',
			counties: '388',
			r2: '0.79'
		},
		urban: {
			coef: '-0.042',
			stars: '***',
			se: '(0.013)',
			title: 'Urban Intensity Controls',
			desc: 'Controls for urbanization share and log population density.',
			n: '12,450',
			counties: '452',
			r2: '0.85'
		}
	};

	function initBrowser() {
		const buttons = document.querySelectorAll('.spec-btn');
		const content = document.getElementById('browser-content');

		buttons.forEach(btn => {
			btn.addEventListener('click', () => {
				buttons.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				
				const data = specs[btn.dataset.spec];
				content.innerHTML = `
					<div class="result-box">
						<div class="stat-main">
							<span class="stat-value">${data.coef}</span>
							<span class="stat-stars">${data.stars}</span>
						</div>
						<div class="stat-label">Coefficient on CathShare × Post</div>
						<div class="stat-se">Standard Error: ${data.se}</div>
					</div>
					<div class="spec-details">
						<h3>Specification: ${data.title}</h3>
						<p>${data.desc}</p>
						<ul class="spec-list">
							<li><strong>N Observations</strong>: ${data.n}</li>
							<li><strong>N Counties</strong>: ${data.counties}</li>
							<li><strong>R-Squared</strong>: ${data.r2}</li>
						</ul>
					</div>
				`;
			});
		});
	}

	document.addEventListener('astro:page-load', initBrowser);
	initBrowser();
</script>

<style>
    .container-wide {
        width: 100%;
    }

	.page-header {
		margin-bottom: 4rem;
	}

	.grid-2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 5rem;
		align-items: center;
	}

	.map-frame {
		border: 1px solid var(--border);
		padding: 1.5rem;
		background: #000;
	}

	.map-frame img {
		width: 100%;
		display: block;
	}

	.map-caption {
		text-align: center;
		font-size: 0.8rem;
		font-style: italic;
		margin-top: 1rem;
		opacity: 0.6;
	}

	/* Browser Styles */
	.browser-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 8px;
		margin-top: 3rem;
		overflow: hidden;
	}

	.browser-nav {
		background: #000;
		padding: 1rem;
		display: flex;
		gap: 1rem;
		border-bottom: 1px solid var(--border);
	}

	.spec-btn {
		background: transparent;
		border: 1px solid var(--border);
		color: var(--text-muted);
		padding: 0.6rem 1.2rem;
		cursor: pointer;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.05rem;
		transition: all 0.3s;
	}

	.spec-btn.active, .spec-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.browser-content {
		padding: 4rem;
		display: grid;
		grid-template-columns: 1fr 1.5fr;
		gap: 4rem;
		align-items: center;
	}

	.stat-main {
		display: flex;
		align-items: flex-start;
		gap: 0.2rem;
	}

	.stat-value {
		font-size: 5rem;
		font-family: var(--serif);
		color: var(--accent);
		line-height: 1;
	}

	.stat-stars {
		font-size: 1.5rem;
		color: var(--accent);
		opacity: 0.8;
	}

	.stat-label {
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.1rem;
		margin: 1rem 0;
		opacity: 0.7;
	}

	.stat-se {
		font-style: italic;
		font-family: var(--serif);
		opacity: 0.6;
	}

	.spec-details h3 {
		font-size: 1.8rem;
		margin-bottom: 1rem;
	}

	.spec-list {
		list-style: none;
		margin-top: 2rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.spec-list li {
		font-size: 0.9rem;
		opacity: 0.8;
	}

	/* Event Study Placeholder */
	.chart-placeholder {
		height: 300px;
		background: rgba(212, 175, 55, 0.03);
		border: 1px solid var(--border);
		margin: 3rem 0;
		padding: 4rem 2rem 2rem;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	.chart-bars {
		height: 200px;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 2rem;
		border-bottom: 1px solid var(--border);
	}

	.bar {
		width: 40px;
		background: var(--text-muted);
		opacity: 0.3;
        position: relative;
	}

	.bar.ref {
		background: var(--accent);
		opacity: 1;
	}

    .bar.ref span {
        position: absolute;
        top: -2rem;
        left: 50%;
        transform: translateX(-50%);
        white-space: nowrap;
        font-size: 0.7rem;
        color: var(--accent);
    }

	.bar.treat {
		background: var(--church);
		opacity: 0.7;
	}

	.chart-axes {
		display: flex;
		justify-content: center;
		gap: 2rem;
		margin-top: 1rem;
		font-size: 0.8rem;
		opacity: 0.5;
	}

	.chart-axes span {
		width: 40px;
		text-align: center;
	}

    .chart-desc {
        text-align: center;
        font-size: 0.95rem;
        opacity: 0.8;
        max-width: 600px;
        margin: 0 auto;
    }

	@media (max-width: 900px) {
		.grid-2, .browser-content {
			grid-template-columns: 1fr;
		}
	}
</style>
