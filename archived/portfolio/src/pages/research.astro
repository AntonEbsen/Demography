---
import Layout from '../layouts/Layout.astro';
import Flowchart from '../components/Flowchart.astro';
import References from '../components/References.astro';
import TrendsChart from '../components/TrendsChart.astro';
import Glossary from '../components/Glossary.astro';
import DidExplainer from '../components/DidExplainer.astro';
import Methodology from '../components/Methodology.astro';
import Citation from '../components/Citation.astro';
import DistrictSpotlight from '../components/DistrictSpotlight.astro';
import SpecBuilder from '../components/SpecBuilder.astro';
import SpatialExplorer from '../components/SpatialExplorer.astro';
import DataHub from '../components/DataHub.astro';
import Critique from '../components/Critique.astro';
---

<Layout title="Research Methodology | The Cost of Quality">
	<main class="container">
		<header>
			<h1>Research Methodology</h1>
			<p>A deep dive into the econometric and demographic framework of the Factory Acts study.</p>
		</header>

		<section class="monograph">
			<h2>1. The Theoretical Anchor: Q-Q Model</h2>
			<p>
				The core of this analysis rests on the <strong>Quantity-Quality (Q-Q) Model</strong>. 
				According to Unified Growth Theory, the primary trigger for the demographic transition 
				is the rise in the demand for human capital.
			</p>
			<blockquote>
				"The Factory Acts introduced a structural break in the economic value of children by 
				simultaneously lowering labor income and raising education costs."
			</blockquote>
			
			<Flowchart />

			<h2>2. The Mechanism: Bounding Child Labor</h2>
			<div class="theory-grid">
				<div class="theory-card">
					<h3>Economic Opportunity Cost</h3>
					<p>When the Factory Acts restricted child labor, the "price" of children changed. They moved from being an asset (a source of income) to a cost (requiring investment without immediate return).</p>
				</div>
				<div class="theory-card">
					<h3>The Education Mandate</h3>
					<p>By coupling labor restrictions with compulsory "part-time" schooling, the Acts lowered the relative cost of education, incentivizing parents to invest in child 'quality'.</p>
				</div>
				<div class="theory-card">
					<h3>Q-Q Shift</h3>
					<p>This exogenous shock forced a microeconomic pivot: households reduced fertility (quantity) to maximize the long-term human capital (quality) of each child.</p>
				</div>
			</div>

			<h2>3. Difference-in-Differences Strategy</h2>
			<p>
				I utilize a <span class="stats-term" data-term="Difference-in-Differences">Difference-in-Differences (DiD)</span> approach with 
				spatial weights. The identification strategy relies on the staggered 
				enforcement of factory laws across textile districts.
			</p>

            <DidExplainer />

			<div class="formula">
				{`$$Fertility_{it} = \\alpha + \\beta(Textile\\_Intensity_{i} \\times Post\\_Policy_{t}) + \\Gamma X_{it} + \\mu_{i} + \\tau_{t} + \\varepsilon_{it}$$`}
			</div>

			<h2>3. Robustness: Oster's Delta</h2>
			<p>
				To address concerns about unobserved selection, I calculate <strong>Oster's Delta (δ)</strong>. 
				This identifies how strong an omitted variable would need to be to nullify the 
				treatment effect. Our primary results show high stability under selection-on-unobservables.
			</p>

			<TrendsChart />

			<h2>4. Results & Robustness</h2>
			<div class="specification-box">
				<div class="controls">
					<button class="spec-btn active" data-spec="baseline">Baseline</button>
					<button class="spec-btn" data-spec="controls">With Controls</button>
					<button class="spec-btn" data-spec="spatial">Spatial Weights</button>
				</div>
				<div class="result-display">
					<div id="spec-content">
						<table class="results-table">
							<thead>
								<tr>
									<th>Variable</th>
									<th>(1) Baseline</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Textile Intensity $\times$ Post</td>
									<td class="impact">-0.042***</td>
								</tr>
								<tr>
									<td></td>
									<td class="se">(0.012)</td>
								</tr>
								<tr class="spacer"></tr>
								<tr>
									<td><span class="stats-term" data-term="Fixed Effects">Registration District FE</span></td>
									<td>Yes</td>
								</tr>
								<tr>
									<td><span class="stats-term" data-term="Census Year FE">Census Year FE</span></td>
									<td>Yes</td>
								</tr>
								<tr>
									<td>Additional Controls</td>
									<td>No</td>
								</tr>
								<tr class="spacer"></tr>
								<tr>
									<td>Observations ($N$)</td>
									<td>40,962</td>
								</tr>
								<tr>
									<td>R-squared ($R^2$)</td>
									<td>0.742</td>
								</tr>
							</tbody>
						</table>
                        <SpecBuilder />
						<aside class="cta">
			<p>Interested in the code behind this analysis?</p>
			<a href="https://github.com/AntonEbsen/Demography" class="github-link">Explore the Repository on GitHub</a>
		</aside>

		<Glossary />

        <Methodology />

		<References />

        <Critique />

        <Citation />
	</main>

    <div id="stats-tooltip" class="stats-popup hidden"></div>

    <script is:inline>
        const termStore = {
            "Difference-in-Differences": "An econometric technique that calculates the causal effect of a policy by comparing the change in outcomes over time between a 'treatment' group and a 'control' group.",
            "Fixed Effects": "A statistical method that controls for time-invariant characteristics of districts (like geography or culture) that might bias our estimates.",
            "Census Year FE": "Controls for national shocks that affect all districts simultaneously in a given census year (e.g., a national economic depression)."
        };

        const tooltip = document.getElementById('stats-tooltip');
        
        function initTooltips() {
            document.querySelectorAll('.stats-term').forEach(el => {
                el.onmouseenter = (e) => {
                    const term = el.getAttribute('data-term') || el.innerText;
                    if (termStore[term]) {
                        tooltip.innerText = termStore[term];
                        const rect = el.getBoundingClientRect();
                        tooltip.style.left = `${rect.left + window.scrollX}px`;
                        tooltip.style.top = `${rect.top + window.scrollY - 60}px`;
                        tooltip.classList.remove('hidden');
                    }
                };
                el.onmouseleave = () => tooltip.classList.add('hidden');
            });
        }

        initTooltips();
        document.addEventListener('astro:page-load', initTooltips);
    </script>

		<script is:inline>
			const specs = {
				baseline: {
					name: '(1) Baseline',
					beta: '-0.042***',
					se: '(0.012)',
					n: '40,962',
					r2: '0.742',
					controls: 'No'
				},
				controls: {
					name: '(2) Full Controls',
					beta: '-0.038***',
					se: '(0.011)',
					n: '40,962',
					r2: '0.789',
					controls: 'IMR, Wages'
				},
				spatial: {
					name: '(3) Spatial Lag',
					beta: '-0.035**',
					se: '(0.014)',
					n: '40,962',
					r2: '0.765',
					controls: 'Spatial Weights'
				}
			};

			const handleSpecClick = () => {
				const buttons = document.querySelectorAll('.spec-btn');
				const content = document.getElementById('spec-content');

				buttons.forEach(btn => {
					btn.addEventListener('click', () => {
						buttons.forEach(b => b.classList.remove('active'));
						btn.classList.add('active');
						const data = specs[btn.dataset.spec];
						content.innerHTML = `
							<table class="results-table">
								<thead>
									<tr>
										<th>Variable</th>
										<th>\${data.name}</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td>Textile Intensity $\times$ Post</td>
										<td class="impact">\${data.beta}</td>
									</tr>
									<tr>
										<td></td>
										<td class="se">\${data.se}</td>
									</tr>
									<tr class="spacer"></tr>
									<tr>
										<td>Registration District FE</td>
										<td>Yes</td>
									</tr>
									<tr>
										<td>Census Year FE</td>
										<td>Yes</td>
									</tr>
									<tr>
										<td>Additional Controls</td>
										<td>\${data.controls}</td>
									</tr>
									<tr class="spacer"></tr>
									<tr>
										<td>Observations ($N$)</td>
										<td>\${data.n}</td>
									</tr>
									<tr>
										<td>R-squared ($R^2$)</td>
										<td>\${data.r2}</td>
									</tr>
								</tbody>
							</table>
							<p class="legend">Standard errors in parentheses. *p<0.1; **p<0.05; ***p<0.01</p>
						`;
						// Re-render KaTeX
						if (window.renderMathInElement) {
							window.renderMathInElement(content);
						}
					});
				});
			};

			document.addEventListener('astro:page-load', handleSpecClick);
		</script>

        <SpatialExplorer />
        <DataHub />
	</main>
</Layout>

<style>
	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}
	header {
		margin-bottom: 4rem;
	}
	h1 {
		font-size: 4rem;
		margin-bottom: 1rem;
	}
	h2 {
		font-size: 2rem;
		margin-top: 4rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid rgba(212, 175, 55, 0.3);
		padding-bottom: 0.5rem;
	}
	blockquote {
		border-left: 4px solid var(--accent);
		padding-left: 2rem;
		margin: 3rem 0;
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.4rem;
	}
	.formula {
		background: var(--secondary);
		padding: 2rem;
		border-radius: 4px;
		font-family: 'Courier New', Courier, monospace;
		text-align: center;
		margin: 2rem 0;
		font-size: 1.1rem;
		border-left: 4px solid var(--accent);
	}
	.cta {
		margin-top: 6rem;
		padding: 4rem;
		background: #000;
		text-align: center;
		border: 1px solid rgba(212, 175, 55, 0.2);
	}
	.github-link {
		color: var(--accent);
		text-decoration: none;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 0.1rem;
	}
	.theory-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 2rem;
		margin: 3rem 0;
	}
	.theory-card {
		background: rgba(212, 175, 55, 0.05);
		padding: 2rem;
		border-left: 2px solid var(--accent);
	}
	.theory-card h3 {
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.1rem;
		margin-bottom: 1rem;
		color: var(--accent);
	}
	.theory-card p {
		font-size: 0.85rem;
		line-height: 1.6;
		opacity: 0.8;
	}
	.specification-box {
		background: var(--secondary);
		padding: 2rem;
		border-radius: 8px;
		margin-top: 2rem;
		border: 1px solid rgba(212, 175, 55, 0.1);
	}
	.controls {
		display: flex;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.spec-btn {
		background: transparent;
		border: 1px solid var(--accent);
		color: var(--accent);
		padding: 0.5rem 1rem;
		cursor: pointer;
		font-family: var(--sans);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.05rem;
		transition: all 0.3s;
	}
	.spec-btn.active, .spec-btn:hover {
		background: var(--accent);
		color: #000;
	}
	.results-table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--serif);
		margin: 1rem 0;
	}
	.results-table thead th {
		border-bottom: 2px solid var(--accent);
		padding: 1rem;
		text-align: left;
		font-weight: bold;
		text-transform: uppercase;
		font-size: 0.9rem;
		letter-spacing: 0.05rem;
	}
	.results-table td {
		padding: 0.75rem 1rem;
		border-bottom: 1px solid rgba(255,255,255,0.05);
	}
	.results-table tr.spacer {
		height: 1.5rem;
		border-bottom: none;
	}
	.results-table tr.spacer td {
		border-bottom: none;
	}
	.impact {
		font-size: 1.3rem;
		font-weight: bold;
		color: var(--accent);
		text-align: right;
	}
	.se {
		text-align: right;
		opacity: 0.8;
		font-style: italic;
	}
	.results-table td:last-child {
		text-align: right;
	}
	.legend {
		font-size: 0.8rem;
		opacity: 0.6;
		margin-top: 1.5rem;
		font-style: italic;
		text-align: right;
	}

    .stats-term {
        border-bottom: 1px dashed var(--accent);
        cursor: help;
        color: var(--accent);
    }
    .stats-popup {
        position: absolute;
        background: var(--secondary);
        border: 1px solid var(--accent);
        padding: 1rem;
        border-radius: 4px;
        font-size: 0.8rem;
        max-width: 250px;
        z-index: 100;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        pointer-events: none;
        transition: opacity 0.2s;
    }
    .hidden { opacity: 0; pointer-events: none; }

    /* Academic "Research Brief" Print Logic */
    @media print {
        :root {
            --accent: #000;
        }
        body {
            background: #fff !important;
            color: #000 !important;
            font-family: 'EB Garamond', serif !important;
        }
        .container {
            max-width: 100% !important;
            padding: 2cm !important;
        }
        h1, h2, h3 {
            color: #000 !important;
            border-bottom: 2px solid #000 !important;
        }
        p, li {
            font-size: 11pt !important;
            line-height: 1.5 !important;
            text-align: justify;
        }
        .theory-grid {
            display: block !important;
        }
        .theory-card {
            background: none !important;
            border: 1px solid #eee !important;
            page-break-inside: avoid;
            margin-bottom: 1rem;
        }
        .specification-box {
            background: #fff !important;
            border: 1px solid #000 !important;
            color: #000 !important;
            page-break-inside: avoid;
        }
        .spec-btn, nav, footer, .map-view, .overlay-controls, .data-hub-container, .cite-wrapper, .github-link {
            display: none !important;
        }
        .formula {
            background: #f9f9f9 !important;
            border: 1px solid #ccc !important;
            color: #000 !important;
        }
        /* Ensure references show up clearly */
        #references {
            page-break-before: always;
        }
    }
</style>
