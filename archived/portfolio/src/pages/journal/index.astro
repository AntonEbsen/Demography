---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('journal')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Research Journal | The Cost of Quality">
	<main class="container">
		<header>
			<h1>Research Journal</h1>
			<p>Field notes, technical updates, and ongoing methodological reflections.</p>
		</header>

		<div class="journal-list">
			{posts.map(post => (
				<article class="journal-card">
					<time datetime={post.data.date.toISOString()}>
						{post.data.date.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</time>
					<h2>
						<a href={`${import.meta.env.BASE_URL}journal/${post.slug}/`}>{post.data.title}</a>
					</h2>
					<p>{post.data.summary}</p>
					<div class="tags">
						{post.data.tags?.map(tag => <span class="tag">#{tag}</span>)}
					</div>
				</article>
			))}
		</div>
	</main>
</Layout>

<style>
	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}
	header {
		margin-bottom: 5rem;
		text-align: center;
	}
	h1 {
		font-size: 4rem;
		margin-bottom: 1rem;
	}
	.journal-list {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}
	.journal-card {
		padding: 3rem;
		background: var(--secondary);
		border: 1px solid rgba(212, 175, 55, 0.1);
		border-radius: 8px;
		transition: all 0.3s;
	}
	.journal-card:hover {
		border-color: var(--accent);
		transform: translateY(-5px);
	}
	time {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1rem;
		opacity: 0.5;
	}
	h2 {
		font-family: var(--serif);
		margin: 1rem 0;
	}
	h2 a {
		color: var(--accent);
		text-decoration: none;
	}
	p {
		font-size: 0.95rem;
		opacity: 0.8;
		line-height: 1.6;
		margin-bottom: 2rem;
	}
	.tags {
		display: flex;
		gap: 1rem;
	}
	.tag {
		font-size: 0.7rem;
		color: var(--accent);
		opacity: 0.6;
		text-transform: uppercase;
	}
</style>
