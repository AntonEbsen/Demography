---
const { baseUrl } = Astro.props;
---
<div class="search-container">
    <button id="search-trigger" aria-label="Open Search">🔍 Search</button>
    <div id="search-modal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <input type="text" id="search-input" placeholder="Search research, stories, or glossary..." />
            <div id="search-results"></div>
        </div>
    </div>
</div>

<script is:inline define:vars={{ baseUrl }}>
    const searchData = [
        { title: "Research Methodology", url: "research/", content: "Econometrics, DiD, Q-Q tradeoff, Stargazer tables" },
        { title: "The Story of the Acts", url: "story/", content: "Manchester, Industrialization, Scrollytelling, History" },
        { title: "Geospatial Explorer", url: "explorer/", content: "Maps, 1851-1881, Registration Districts, Heatmaps" },
        { title: "Learning Resources", url: "resources/", content: "Archives, Unified Growth Theory, Becker, Galor" },
        { title: "Genesis of the Dataset", url: "journal/genesis-of-dataset/", content: "Census, Harmonization, Spatial Join" },
        { title: "Glossary", url: "research/#glossary", content: "TFR, Oster's Delta, Spatial Weights, Endogeneity" }
    ];

    const searchInput = document.getElementById('search-input');
    const searchResults = document.getElementById('search-results');
    const modal = document.getElementById('search-modal');
    const trigger = document.getElementById('search-trigger');
    const closeBtn = document.querySelector('.close');

    if (trigger) {
        trigger.onclick = () => modal.style.display = "block";
        closeBtn.onclick = () => modal.style.display = "none";
        window.onclick = (event) => { if (event.target == modal) modal.style.display = "none"; }

        searchInput.oninput = (e) => {
            const query = e.target.value.toLowerCase();
            if (!query) { searchResults.innerHTML = ''; return; }
            
            const matches = searchData.filter(item => 
                item.title.toLowerCase().includes(query) || 
                item.content.toLowerCase().includes(query)
            );

            searchResults.innerHTML = matches.map(match => `
                <div class="result-item">
                    <a href="\${baseUrl}\${match.url}">
                        <strong>\${match.title}</strong>
                        <p>\${match.content}</p>
                    </a>
                </div>
            `).join('');
        };
    }
</script>

<style>
    #search-trigger {
        background: rgba(212, 175, 55, 0.1);
        border: 1px solid var(--accent);
        color: var(--accent);
        padding: 0.4rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        font-family: var(--sans);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05rem;
    }
    .modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.9);
        backdrop-filter: blur(10px);
    }
    .modal-content {
        background-color: var(--secondary);
        margin: 10% auto;
        padding: 3rem;
        border: 1px solid var(--accent);
        width: 80%;
        max-width: 600px;
        border-radius: 8px;
    }
    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }
    #search-input {
        width: 100%;
        padding: 1rem;
        background: #000;
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: white;
        font-size: 1.2rem;
        margin: 2rem 0;
        outline: none;
    }
    #search-input:focus {
        border-color: var(--accent);
    }
    .result-item {
        margin-bottom: 1.5rem;
    }
    .result-item a {
        text-decoration: none;
        color: white;
    }
    .result-item strong {
        color: var(--accent);
        font-family: var(--serif);
        font-size: 1.2rem;
    }
    .result-item p {
        font-size: 0.8rem;
        opacity: 0.6;
    }
</style>
