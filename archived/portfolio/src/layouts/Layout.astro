---
import { ClientRouter } from 'astro:transitions';
import Search from '../components/Search.astro';
import Basket from '../components/Basket.astro';
import CiteButton from '../components/CiteButton.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="A research portfolio on the Victorian fertility transition." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- OpenGraph / Social Meta Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://AntonEbsen.github.io/Demography/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="A PhD research showcase on the Victorian fertility transition and child labor laws." />
		<meta property="og:image" content="https://AntonEbsen.github.io/Demography/preview.jpg" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://AntonEbsen.github.io/Demography/" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content="A PhD research showcase on the Victorian fertility transition and child labor laws." />
		<meta property="twitter:image" content="https://AntonEbsen.github.io/Demography/preview.jpg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Outfit:wght@100..900&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFas96IlUsV" crossorigin="anonymous">
		<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" integrity="sha384-XjKyOOlGwcjNTAIQHIWDoAqhFQQsLKCETS9PsNoipu8VjYB176SJi5ZP9RePspLT" crossorigin="anonymous"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" integrity="sha384-+VBxd3r6XgURycqtZ117nYw44OOcIax56Z4dCRWbxyPt0Koah1uHoK0o4+/RRE05" crossorigin="anonymous" onload="renderMathInElement(document.body);"></script>
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#d4af37" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<ClientRouter />
	</head>
	<body>
		<nav>
			<div class="nav-content">
				<a href={`${import.meta.env.BASE_URL}`} class="logo">The Cost of Quality</a>
				<div class="links">
					<a href={`${import.meta.env.BASE_URL}story/`} data-t="nav_story">Story</a>
					<a href={`${import.meta.env.BASE_URL}research/`} data-t="nav_research">Research</a>
					<a href={`${import.meta.env.BASE_URL}dashboard/`} data-t="nav_dashboard">Dashboard</a>
					<a href={`${import.meta.env.BASE_URL}explorer/`} data-t="nav_explorer">Explorer</a>
					<a href={`${import.meta.env.BASE_URL}journal/`} data-t="nav_journal">Journal</a>
					<a href={`${import.meta.env.BASE_URL}resources/`} data-t="nav_resources">Resources</a>
					<a href={`${import.meta.env.BASE_URL}about/`} data-t="nav_about">About</a>
                    <a href="https://antonebsen.dk/" target="_blank" class="nav-ext">antonebsen.dk</a>
                    <Search baseUrl={import.meta.env.BASE_URL} />
                    <button id="lang-toggle" class="lang-btn">DA</button>
					<button id="theme-toggle" aria-label="Toggle Light Mode" class="theme-btn">
						<span class="sun">🌞</span>
						<span class="moon">🌙</span>
					</button>
				</div>
			</div>
		</nav>
		<slot />
        <Basket />
		<CiteButton />
		<footer>
			<p>&copy; 2026 Anton Ebsen. Built with Astro & Professional Rigor. <a href="https://antonebsen.dk/" target="_blank" style="color: var(--accent); text-decoration: underline; margin-left: 10px;">Personal Website ↗</a></p>
		</footer>

		<script is:inline>
			const initTheme = () => {
				const theme = localStorage.getItem('theme') || 'dark';
				document.documentElement.setAttribute('data-theme', theme);
			};

			const initLang = () => {
				const lang = localStorage.getItem('lang') || 'en';
				const langBtn = document.getElementById('lang-toggle');
				const t = {
					en: {
						nav_story: "Story", nav_research: "Research", nav_dashboard: "Dashboard", nav_explorer: "Explorer", 
						nav_journal: "Journal", nav_resources: "Resources", nav_about: "About",
						hero_title: "The Cost of Quality", hero_subtitle: "How Legislative Shocks to Child Labor Transformed the British Fertility Transition",
						cta_story: "Explore the Story", cta_research: "View the Evidence"
					},
					da: {
						nav_story: "Fortælling", nav_research: "Forskning", nav_dashboard: "Dashboard", nav_explorer: "Kort", 
						nav_journal: "Journal", nav_resources: "Ressourcer", nav_about: "Om",
						hero_title: "Omkostningen ved Kvalitet", hero_subtitle: "Hvordan lovgivningsmæssige chok til børnearbejde transformerede den britiske fertilitetsovergang",
						cta_story: "Udforsk Historien", cta_research: "Se Beviserne"
					}
				};

				const updateLang = (newLang) => {
					document.querySelectorAll('[data-t]').forEach(el => {
						const key = el.getAttribute('data-t');
						if (t[newLang][key]) el.innerText = t[newLang][key];
					});
					if (langBtn) langBtn.innerText = newLang === 'en' ? 'DA' : 'EN';
					localStorage.setItem('lang', newLang);
				};

				updateLang(lang);

				if (langBtn) {
					langBtn.onclick = () => {
						const currentLang = localStorage.getItem('lang') || 'en';
						updateLang(currentLang === 'en' ? 'da' : 'en');
					};
				}
			};

			initTheme();
			initLang();

			document.addEventListener('astro:page-load', () => {
				const themeBtn = document.getElementById('theme-toggle');
				if (themeBtn) {
					themeBtn.onclick = () => {
						const currentTheme = document.documentElement.getAttribute('data-theme');
						const newTheme = currentTheme === 'light' ? 'dark' : 'light';
						document.documentElement.setAttribute('data-theme', newTheme);
						localStorage.setItem('theme', newTheme);
					};
				}
				initLang();
				
				if (window.renderMathInElement) {
					window.renderMathInElement(document.body, {
						delimiters: [
							{left: '$$', right: '$$', display: true},
							{left: '$', right: '$', display: false},
							{left: '\\(', right: '\\)', display: false},
							{left: '\\[', right: '\\]', display: true}
						],
						throwOnError: false
					});
				}
			});

			// PWA Service Worker Registration
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(err => {
						console.log('SW registration failed: ', err);
					});
				});
			}
		</script>
	</body>
</html>
<style is:global>
	:root {
		--bg: #0f1012;
		--text: #e0e0e0;
		--accent: #d4af37;
		--secondary: #1a1c20;
		--serif: 'EB Garamond', serif;
		--sans: 'Outfit', sans-serif;
	}
	[data-theme='light'] {
		--bg: #f8f9fa;
		--text: #1a1c20;
		--accent: #b8860b;
		--secondary: #e9ecef;
	}
	html {
		background: var(--bg);
		color: var(--text);
		transition: background-color 0.3s, color 0.3s;
		font-family: var(--sans);
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	nav {
		background: rgba(15, 16, 18, 0.8);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(212, 175, 55, 0.2);
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 1rem 0;
	}
	.nav-content {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.logo {
		font-family: var(--serif);
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		letter-spacing: 0.05rem;
	}
	.links {
		display: flex;
		gap: 2rem;
	}
	.links a {
		text-decoration: none;
		color: var(--text);
		font-weight: 500;
		transition: color 0.3s;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.1rem;
	}
	.links a:hover {
		color: var(--accent);
	}
    .nav-ext {
        color: var(--accent) !important;
        font-weight: bold;
        opacity: 0.8;
    }
    .nav-ext:hover {
        opacity: 1;
        text-shadow: 0 0 10px rgba(212, 175, 55, 0.4);
    }
	.theme-btn, .lang-btn {
		background: transparent;
		border: 1px solid var(--accent);
		color: var(--accent);
		cursor: pointer;
		padding: 0.5rem;
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.3s;
        font-family: var(--sans);
        font-size: 0.7rem;
        font-weight: bold;
        min-width: 40px;
	}
	.theme-btn:hover, .lang-btn:hover {
		background: var(--accent);
		color: #000;
	}
	.theme-btn {
		filter: drop-shadow(0 0 5px rgba(212, 175, 55, 0.3));
	}
	.theme-btn:hover {
		transform: scale(1.1);
	}
	.sun { display: none; }
	.moon { display: block; }

	[data-theme='light'] .sun { display: block; }
	[data-theme='light'] .moon { display: none; }
	[data-theme='light'] .theme-btn { border-color: #b8860b; }
	footer {
		margin-top: auto;
		padding: 4rem 0 2rem;
		text-align: center;
		font-size: 0.8rem;
		opacity: 0.6;
	}

	/* Print optimization for Research Brief */
	@media print {
		nav, .theme-btn, .cta, .spec-btn, .github-link, footer, .controls {
			display: none !important;
		}
		body {
			background: white !important;
			color: black !important;
		}
		.container {
			max-width: 100% !important;
			padding: 0 !important;
		}
		h1, h2, h3 {
			color: black !important;
			page-break-after: avoid;
		}
		.monograph {
			column-count: 2;
			column-gap: 3rem;
		}
		.results-table {
			border: 1px solid #ccc;
			page-break-inside: avoid;
		}
		.results-table thead th {
			border-bottom: 2px solid black;
			color: black;
		}
		.impact {
			color: black;
		}
	}
	h1, h2, h3 {
		font-family: var(--serif);
		color: var(--accent);
	}
	p {
		line-height: 1.6;
		margin-bottom: 1.5rem;
		font-size: 1.1rem;
	}
</style>
