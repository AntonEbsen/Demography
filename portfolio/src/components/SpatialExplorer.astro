---
/**
 * SpatialExplorer.astro
 * Visualizes the "Textile District" fertility premium across England & Wales.
 */
---

<div class="spatial-explorer-container" id="spatial-explorer">
  <div class="explorer-header">
    <h3><span class="step-badge">12</span> Spatial Autocorrelation & Spillovers</h3>
    <p>Districts with high textile industry intensity (e.g., Lancashire, West Riding) exhibited a distinct <strong>+0.7 TFR premium</strong>. This map visualizes the spatial clustering of high-fertility industrial hubs.</p>
  </div>

  <div class="explorer-layout">
    <div class="map-view">
      <!-- Simplified England & Wales SVG with highlighted industrial zones -->
      <svg viewBox="0 0 400 500" class="mini-map">
        <!-- Mainland -->
        <path d="M150,450 L100,400 L80,300 L50,250 L80,150 L120,80 L200,50 L280,80 L320,150 L350,250 L320,350 L280,450 Z" class="map-base" />
        
        <!-- Textile Districts (Clustered in the North/Midlands) -->
        <circle cx="160" cy="180" r="25" class="textile-hub" data-info="Lancashire: +0.72 TFR" />
        <circle cx="210" cy="200" r="20" class="textile-hub" data-info="West Riding: +0.68 TFR" />
        <circle cx="190" cy="260" r="15" class="textile-hub" data-info="Derbyshire: +0.55 TFR" />
        <circle cx="140" cy="270" r="10" class="textile-hub" data-info="Cheshire: +0.60 TFR" />

        <!-- Legend -->
        <rect x="20" y="420" width="15" height="15" fill="var(--accent)" fill-opacity="0.8" />
        <text x="45" y="432" fill="white" font-size="12">Textile Premium RD</text>
      </svg>
      
      <div id="map-tooltip" class="map-tooltip">Hover over a cluster</div>
    </div>

    <div class="analysis-meta">
      <div class="premium-stat">
        <span class="stat-label">Industrial Premium</span>
        <span class="stat-value">+0.7 TFR</span>
        <p>Textile districts maintained significantly higher fertility than neighboring rural areas, even after controlling for income.</p>
      </div>

      <div class="overlay-controls">
        <label class="overlay-toggle">
          <input type="checkbox" id="toggle-coal">
          <span class="dot coal"></span>
          Show Coal Basins
        </label>
        <label class="overlay-toggle">
          <input type="checkbox" id="toggle-rail">
          <span class="dot rail"></span>
          Show Railway Density
        </label>
      </div>

      <div class="spatial-note">
        <h4>Infrastructure & Energy</h4>
        <p>Did institutional shocks (Factory Acts) or infrastructure (Railways) drive the transition? Use the toggles to see the spatial correlation between coal energy hubs and high-fertility clusters.</p>
        <p class="disclaimer">Note: Overlays are stylized based on historical density centers.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .spatial-explorer-container {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.4), rgba(15, 23, 42, 0.4));
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.5rem;
    margin: 3rem 0;
    color: #cbd5e1;
    overflow: hidden;
  }

  .explorer-header h3 {
    margin-bottom: 0.5rem;
    color: white;
  }

  .explorer-layout {
    display: flex;
    gap: 3rem;
    align-items: center;
    margin-top: 2rem;
  }

  .map-view {
    position: relative;
    flex: 1;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 16px;
    padding: 1rem;
    display: flex;
    justify-content: center;
  }

  .mini-map {
    width: 300px;
    height: auto;
    filter: drop-shadow(0 0 20px rgba(96, 165, 250, 0.1));
  }

  .map-base {
    fill: #1e293b;
    stroke: rgba(255, 255, 255, 0.1);
    stroke-width: 2;
  }

  .textile-hub {
    fill: var(--accent);
    fill-opacity: 0.4;
    stroke: var(--accent);
    stroke-width: 2;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .textile-hub:hover {
    fill-opacity: 0.9;
    transform: scale(1.1);
    filter: drop-shadow(0 0 10px var(--accent));
  }

  .coal-basin {
    fill: #334155;
    fill-opacity: 0;
    stroke: #475569;
    stroke-dasharray: 4;
    transition: fill-opacity 0.5s ease;
    pointer-events: none;
  }

  .rail-line {
    stroke: #64748b;
    stroke-width: 1.5;
    stroke-opacity: 0;
    fill: none;
    transition: stroke-opacity 0.5s ease;
    pointer-events: none;
  }

  .map-tooltip {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: white;
    padding: 8px 16px;
    border-radius: 99px;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .analysis-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .premium-stat {
    background: rgba(212, 175, 55, 0.1);
    padding: 1.5rem;
    border-left: 4px solid var(--accent);
    border-radius: 8px;
  }

  .stat-label {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: white;
  }

  .overlay-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.2);
    padding: 1rem;
    border-radius: 12px;
  }

  .overlay-toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot.coal { background: #475569; }
  .dot.rail { background: #64748b; }

  .spatial-note h4 {
    color: white;
    margin-bottom: 0.75rem;
  }

  .spatial-note p {
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.8;
  }

  .disclaimer {
    font-size: 0.7rem !important;
    font-style: italic;
    opacity: 0.5 !important;
    margin-top: 1rem;
  }

  @media (max-width: 1024px) {
    .explorer-layout {
      flex-direction: column;
    }
  }
</style>

<script is:inline>
  function initSpatial() {
    const hubs = document.querySelectorAll('.textile-hub');
    const tooltip = document.getElementById('map-tooltip');
    const coalToggle = document.getElementById('toggle-coal');
    const railToggle = document.getElementById('toggle-rail');

    const coalBasins = document.querySelectorAll('.coal-basin');
    const railLines = document.querySelectorAll('.rail-line');

    hubs.forEach(hub => {
      hub.addEventListener('mouseenter', () => {
        tooltip.textContent = hub.getAttribute('data-info');
        tooltip.style.opacity = '1';
      });
      hub.addEventListener('mouseleave', () => {
        tooltip.style.opacity = '0';
      });
    });

    coalToggle?.addEventListener('change', (e) => {
      coalBasins.forEach(b => b.style.fillOpacity = e.target.checked ? '0.4' : '0');
    });

    railToggle?.addEventListener('change', (e) => {
      railLines.forEach(l => l.style.strokeOpacity = e.target.checked ? '0.3' : '0');
    });
  }

  initSpatial();
  document.addEventListener('astro:page-load', initSpatial);
</script>
