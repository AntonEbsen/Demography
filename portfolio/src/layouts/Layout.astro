---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="A research portfolio on the Victorian fertility transition." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Outfit:wght@100..900&display=swap" rel="stylesheet">
	</head>
	<body>
		<nav>
			<div class="nav-content">
				<a href="/" class="logo">The Cost of Quality</a>
				<div class="links">
					<a href="/research">Research</a>
					<a href="/evidence">Evidence</a>
					<a href="/about">About</a>
				</div>
			</div>
		</nav>
		<slot />
		<footer>
			<p>&copy; 2026 Anton Ebsen. Built with Astro & Professional Rigor.</p>
		</footer>
	</body>
</html>
<style is:global>
	:root {
		--bg: #0f1012;
		--text: #e0e0e0;
		--accent: #d4af37;
		--secondary: #1a1c20;
		--serif: 'EB Garamond', serif;
		--sans: 'Outfit', sans-serif;
	}
	html {
		background: var(--bg);
		color: var(--text);
		font-family: var(--sans);
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	nav {
		background: rgba(15, 16, 18, 0.8);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(212, 175, 55, 0.2);
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 1rem 0;
	}
	.nav-content {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.logo {
		font-family: var(--serif);
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		letter-spacing: 0.05rem;
	}
	.links {
		display: flex;
		gap: 2rem;
	}
	.links a {
		text-decoration: none;
		color: var(--text);
		font-weight: 500;
		transition: color 0.3s;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.1rem;
	}
	.links a:hover {
		color: var(--accent);
	}
	footer {
		margin-top: auto;
		padding: 4rem 0 2rem;
		text-align: center;
		font-size: 0.8rem;
		opacity: 0.6;
	}
	h1, h2, h3 {
		font-family: var(--serif);
		color: var(--accent);
	}
	p {
		line-height: 1.6;
		margin-bottom: 1.5rem;
		font-size: 1.1rem;
	}
</style>
