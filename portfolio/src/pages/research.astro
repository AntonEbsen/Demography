---
import Layout from '../layouts/Layout.astro';
import Flowchart from '../components/Flowchart.astro';
import References from '../components/References.astro';
import TrendsChart from '../components/TrendsChart.astro';
---

<Layout title="Research Methodology | The Cost of Quality">
	<main class="container">
		<header>
			<h1>Research Methodology</h1>
			<p>A deep dive into the econometric and demographic framework of the Factory Acts study.</p>
		</header>

		<section class="monograph">
			<h2>1. The Theoretical Anchor: Q-Q Model</h2>
			<p>
				The core of this analysis rests on the <strong>Quantity-Quality (Q-Q) Model</strong>. 
				According to Unified Growth Theory, the primary trigger for the demographic transition 
				is the rise in the demand for human capital.
			</p>
			<blockquote>
				"The Factory Acts introduced a structural break in the economic value of children by 
				simultaneously lowering labor income and raising education costs."
			</blockquote>
			
			<Flowchart />

			<h2>2. Difference-in-Differences Strategy</h2>
			<p>
				I utilize a <strong>Difference-in-Differences (DiD)</strong> approach with 
				spatial weights. The identification strategy relies on the staggered 
				enforcement of factory laws across textile districts.
			</p>
			<div class="formula">
				{`$$Fertility_{it} = \\alpha + \\beta(Textile\\_Intensity_{i} \\times Post\\_Policy_{t}) + \\Gamma X_{it} + \\mu_{i} + \\tau_{t} + \\varepsilon_{it}$$`}
			</div>

			<h2>3. Robustness: Oster's Delta</h2>
			<p>
				To address concerns about unobserved selection, I calculate <strong>Oster's Delta (δ)</strong>. 
				This identifies how strong an omitted variable would need to be to nullify the 
				treatment effect. Our primary results show high stability under selection-on-unobservables.
			</p>

			<TrendsChart />

			<h2>4. Results & Robustness</h2>
			<div class="specification-box">
				<div class="controls">
					<button class="spec-btn active" data-spec="baseline">Baseline</button>
					<button class="spec-btn" data-spec="controls">With Controls</button>
					<button class="spec-btn" data-spec="spatial">Spatial Weights</button>
				</div>
				<div class="result-display">
					<div id="spec-content">
						<table class="results-table">
							<thead>
								<tr>
									<th>Variable</th>
									<th>(1) Baseline</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Textile Intensity $\times$ Post</td>
									<td class="impact">-0.042***</td>
								</tr>
								<tr>
									<td></td>
									<td class="se">(0.012)</td>
								</tr>
								<tr class="spacer"></tr>
								<tr>
									<td>Registration District FE</td>
									<td>Yes</td>
								</tr>
								<tr>
									<td>Census Year FE</td>
									<td>Yes</td>
								</tr>
								<tr>
									<td>Additional Controls</td>
									<td>No</td>
								</tr>
								<tr class="spacer"></tr>
								<tr>
									<td>Observations ($N$)</td>
									<td>40,962</td>
								</tr>
								<tr>
									<td>R-squared ($R^2$)</td>
									<td>0.742</td>
								</tr>
							</tbody>
						</table>
						<p class="legend">Standard errors in parentheses. *p<0.1; **p<0.05; ***p<0.01</p>
					</div>
				</div>
			</div>
		</section>

		</aside>

		<References />
	</main>

		<script is:inline>
			const specs = {
				baseline: {
					name: '(1) Baseline',
					beta: '-0.042***',
					se: '(0.012)',
					n: '40,962',
					r2: '0.742',
					controls: 'No'
				},
				controls: {
					name: '(2) Full Controls',
					beta: '-0.038***',
					se: '(0.011)',
					n: '40,962',
					r2: '0.789',
					controls: 'IMR, Wages'
				},
				spatial: {
					name: '(3) Spatial Lag',
					beta: '-0.035**',
					se: '(0.014)',
					n: '40,962',
					r2: '0.765',
					controls: 'Spatial Weights'
				}
			};

			const handleSpecClick = () => {
				const buttons = document.querySelectorAll('.spec-btn');
				const content = document.getElementById('spec-content');

				buttons.forEach(btn => {
					btn.addEventListener('click', () => {
						buttons.forEach(b => b.classList.remove('active'));
						btn.classList.add('active');
						const data = specs[btn.dataset.spec];
						content.innerHTML = `
							<table class="results-table">
								<thead>
									<tr>
										<th>Variable</th>
										<th>\${data.name}</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td>Textile Intensity $\times$ Post</td>
										<td class="impact">\${data.beta}</td>
									</tr>
									<tr>
										<td></td>
										<td class="se">\${data.se}</td>
									</tr>
									<tr class="spacer"></tr>
									<tr>
										<td>Registration District FE</td>
										<td>Yes</td>
									</tr>
									<tr>
										<td>Census Year FE</td>
										<td>Yes</td>
									</tr>
									<tr>
										<td>Additional Controls</td>
										<td>\${data.controls}</td>
									</tr>
									<tr class="spacer"></tr>
									<tr>
										<td>Observations ($N$)</td>
										<td>\${data.n}</td>
									</tr>
									<tr>
										<td>R-squared ($R^2$)</td>
										<td>\${data.r2}</td>
									</tr>
								</tbody>
							</table>
							<p class="legend">Standard errors in parentheses. *p<0.1; **p<0.05; ***p<0.01</p>
						`;
						// Re-render KaTeX
						if (window.renderMathInElement) {
							window.renderMathInElement(content);
						}
					});
				});
			};

			document.addEventListener('astro:page-load', handleSpecClick);
		</script>
	</main>
</Layout>

<style>
	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}
	header {
		margin-bottom: 4rem;
	}
	h1 {
		font-size: 4rem;
		margin-bottom: 1rem;
	}
	h2 {
		font-size: 2rem;
		margin-top: 4rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid rgba(212, 175, 55, 0.3);
		padding-bottom: 0.5rem;
	}
	blockquote {
		border-left: 4px solid var(--accent);
		padding-left: 2rem;
		margin: 3rem 0;
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.4rem;
	}
	.formula {
		background: var(--secondary);
		padding: 2rem;
		border-radius: 4px;
		font-family: 'Courier New', Courier, monospace;
		text-align: center;
		margin: 2rem 0;
		font-size: 1.1rem;
		border-left: 4px solid var(--accent);
	}
	.cta {
		margin-top: 6rem;
		padding: 4rem;
		background: #000;
		text-align: center;
		border: 1px solid rgba(212, 175, 55, 0.2);
	}
	.github-link {
		color: var(--accent);
		text-decoration: none;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 0.1rem;
	}
	.specification-box {
		background: var(--secondary);
		padding: 2rem;
		border-radius: 8px;
		margin-top: 2rem;
		border: 1px solid rgba(212, 175, 55, 0.1);
	}
	.controls {
		display: flex;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.spec-btn {
		background: transparent;
		border: 1px solid var(--accent);
		color: var(--accent);
		padding: 0.5rem 1rem;
		cursor: pointer;
		font-family: var(--sans);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.05rem;
		transition: all 0.3s;
	}
	.spec-btn.active, .spec-btn:hover {
		background: var(--accent);
		color: #000;
	}
	.results-table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--serif);
		margin: 1rem 0;
	}
	.results-table thead th {
		border-bottom: 2px solid var(--accent);
		padding: 1rem;
		text-align: left;
		font-weight: bold;
		text-transform: uppercase;
		font-size: 0.9rem;
		letter-spacing: 0.05rem;
	}
	.results-table td {
		padding: 0.75rem 1rem;
		border-bottom: 1px solid rgba(255,255,255,0.05);
	}
	.results-table tr.spacer {
		height: 1.5rem;
		border-bottom: none;
	}
	.results-table tr.spacer td {
		border-bottom: none;
	}
	.impact {
		font-size: 1.3rem;
		font-weight: bold;
		color: var(--accent);
		text-align: right;
	}
	.se {
		text-align: right;
		opacity: 0.8;
		font-style: italic;
	}
	.results-table td:last-child {
		text-align: right;
	}
	.legend {
		font-size: 0.8rem;
		opacity: 0.6;
		margin-top: 1.5rem;
		font-style: italic;
		text-align: right;
	}
</style>
