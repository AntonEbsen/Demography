---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About the Researcher | The Cost of Quality">
	<main class="container">
		<div class="profile-grid">
			<div class="profile-text">
				<h1>Anton Ebsen</h1>
				<p class="role">Economic History Researcher & Demographic Analyst</p>
				
				<div class="bio">
					<p>
						I am a researcher focused on the intersection of labor economics, legislative 
						history, and long-run demographic transitions. My work utilizes advanced 
						econometric models and geospatial analysis to uncover the drivers of 
						human capital accumulation in 19th-century Europe.
					</p>
					<p>
						My current ambition is to pursue a <strong>PhD in Economic History</strong>, focusing on how 
						institutional shifts in education and labor law catalyzed the modern economic 
						take-off. I am particularly interested in the role of factory inspectorates 
						and the state's capacity to enforce social legislation.
					</p>
				</div>

				<div class="social-links">
					<a href="https://www.linkedin.com/in/antonebsen/" target="_blank">LinkedIn</a>
					<a href="https://github.com/AntonEbsen" target="_blank">GitHub</a>
				</div>
			</div>
			
			<div class="profile-links">
				<h3>Project Resources</h3>
				<ul class="resource-list">
					<li>
						<a href="https://antonebsen.github.io/Demography/api">
							<strong>API Documentation</strong>
							<span>Modular Python utilities for spatial analysis.</span>
						</a>
					</li>
					<li>
						<a href="https://share.streamlit.io/antonebsen/demography/main/exam_project/src/app.py" target="_blank">
							<strong>Interactive Dashboard</strong>
							<span>Streamlit-based explorative diagnostics and maps.</span>
						</a>
					</li>
					<li>
						<button onclick="window.print()" class="print-brief-btn">
							<strong>Generate Research Brief (PDF)</strong>
							<span>Typeset summary of the Factory Acts analysis.</span>
						</button>
					</li>
					<li>
						<a href="https://github.com/AntonEbsen/Demography/blob/main/exam_project/notebooks/exam_project.ipynb">
							<strong>Full Notebook</strong>
							<span>Complete reproducible analysis pipeline.</span>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</main>
</Layout>

<style>
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 6rem 2rem;
	}
	.profile-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 6rem;
		align-items: start;
	}
	h1 {
		font-size: 4rem;
		margin-bottom: 0.5rem;
	}
	.role {
		font-size: 1.2rem;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.1rem;
		margin-bottom: 3rem;
		font-weight: 600;
	}
	.bio {
		margin-bottom: 4rem;
	}
	.social-links {
		display: flex;
		gap: 2rem;
	}
	.social-links a {
		color: var(--text);
		text-decoration: none;
		font-weight: bold;
		border-bottom: 2px solid var(--accent);
		padding-bottom: 2px;
	}
	h3 {
		font-size: 1.5rem;
		margin-bottom: 2rem;
		text-transform: uppercase;
		letter-spacing: 0.1rem;
	}
	.resource-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.resource-list li a, .print-brief-btn {
		text-decoration: none;
		color: var(--text);
		display: block;
		padding: 1.5rem;
		background: var(--secondary);
		border-radius: 4px;
		transition: transform 0.3s;
		border: 1px solid rgba(255,255,255,0.05);
		width: 100%;
		text-align: left;
		cursor: pointer;
		font-family: inherit;
	}
	.resource-list li a:hover, .print-brief-btn:hover {
		transform: scale(1.02);
		border-color: var(--accent);
	}
	.resource-list strong {
		display: block;
		color: var(--accent);
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}
	.resource-list span {
		font-size: 0.9rem;
		opacity: 0.7;
	}

	@media (max-width: 800px) {
		.profile-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
